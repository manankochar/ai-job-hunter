# Database Configuration
# Async PostgreSQL (production/docker) or local SQLite
DATABASE_URL=sqlite+aiosqlite:///./ai_job_hunter.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/ai_job_hunter

# Security
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string
# Fernet symmetric encryption key for OAuth tokens stored in DB (Generate with cryptography.fernet.Fernet.generate_key())
ENCRYPTION_KEY=v9u12Jc6Bsm9y-l7cEaK17U_wB_X35o4F6KjL0Y7M8Q=

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth & Gmail API
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/gmail/callback

# UiPath Orchestrator RPA
UIPATH_BASE_URL=https://cloud.uipath.com
UIPATH_ACCOUNT_LOGICAL_NAME=your_account_name
UIPATH_TENANT_NAME=your_tenant_name
UIPATH_FOLDER_ID=your_folder_id
UIPATH_CLIENT_ID=your_uipath_external_app_client_id
UIPATH_CLIENT_SECRET=your_uipath_external_app_client_secret

# Safeguards
DEFAULT_DAILY_EMAIL_LIMIT=10
